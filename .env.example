# Axom MCP Server Environment Variables
# Persistent Memory: Axom (SQLite)

# Database Configuration (SQLite)
# Path to the SQLite database file
# Default: ~/.axom/axom.db (on Windows: C:\Users\<username>\.axom\axom.db)
AXOM_DB_PATH=

# Read-Only Mode (defaults to false - writes allowed)
# Uncomment to disable writes: AXOM_READ_ONLY=true

# Logging Configuration
LOG_LEVEL=INFO

# Optional: Memory Configuration
AXOM_MAX_MEMORY_SIZE=1000000
AXOM_CLEANUP_INTERVAL=3600

# Memory Expiration Defaults (in days, 0 = never)
AXOM_EXPIRE_SHORT_TERM=30
AXOM_EXPIRE_LONG_TERM=365
AXOM_EXPIRE_REFLEX=90
AXOM_EXPIRE_DREAMS=180

# Optional: Chain Execution Limits
AXOM_MAX_CHAIN_DEPTH=10
AXOM_CHAIN_TIMEOUT_SECONDS=300
